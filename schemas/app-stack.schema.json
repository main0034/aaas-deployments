{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/main0034/aaas-deployments/schemas/app-stack.schema.json",
  "title": "app-stack deployment inputs",
  "description": "The complete set of values an agent may write into terraform.tfvars.json. This schema is the authoritative contract: if it disagrees with the module README, the schema wins. CI validates every deployment against this file before Terraform runs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "environment", "container_image", "tags"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,20}[a-z0-9]$",
      "description": "Deployment slug. Must match the directory name."
    },
    "environment": {
      "type": "string",
      "enum": ["dev"]
    },
    "location": {
      "type": "string",
      "enum": ["swedencentral", "westeurope", "northeurope"],
      "default": "swedencentral"
    },
    "container_image": {
      "type": "string",
      "pattern": "^[a-z0-9.\\-_/:]+:([0-9a-f]{40}|bootstrap)$",
      "description": "Image tag must be an immutable 40-char git SHA. The literal 'bootstrap' is permitted only for the initial apply, before any image has been built. Mutable tags such as ':latest' are rejected."
    },
    "container_port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8000
    },
    "cpu": {
      "type": "number",
      "enum": [0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 1.75, 2.0],
      "default": 0.25
    },
    "memory": {
      "type": "string",
      "enum": ["0.5Gi", "1Gi", "1.5Gi", "2Gi", "2.5Gi", "3Gi", "3.5Gi", "4Gi"],
      "default": "0.5Gi",
      "description": "Must equal exactly cpu x 2 in Gi. Container Apps rejects any other pairing."
    },
    "min_replicas": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3,
      "default": 0
    },
    "max_replicas": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 2
    },
    "app_env": {
      "type": "object",
      "description": "Non-secret environment variables only. Keys must be UPPER_SNAKE_CASE and must not name a credential - secrets are provisioned through Key Vault, never through this map.",
      "additionalProperties": { "type": "string" },
      "propertyNames": {
        "allOf": [
          {
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "$comment": "Uppercase convention also makes the credential check below reliable without case-insensitive regex, which JSON Schema (ECMA-262) does not support via inline flags."
          },
          {
            "not": { "pattern": "(PASSWORD|SECRET|TOKEN|KEY|CREDENTIAL|CONN)" }
          }
        ]
      },
      "default": {}
    },
    "postgres_sku": {
      "type": "string",
      "enum": ["B_Standard_B1ms", "B_Standard_B2s"],
      "default": "B_Standard_B1ms",
      "description": "Burstable tiers only. General Purpose SKUs are excluded on cost grounds (~100 USD/month) and must not be added without a deliberate human decision."
    },
    "postgres_storage_mb": {
      "type": "integer",
      "enum": [32768, 65536],
      "default": 32768,
      "description": "32 GB or 64 GB. Storage cannot be reduced after creation, only grown, so an over-sized choice is permanent."
    },
    "postgres_version": {
      "type": "string",
      "enum": ["15", "16"],
      "default": "16"
    },
    "database_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,30}$",
      "default": "appdb"
    },
    "postgres_backup_retention_days": {
      "type": "integer",
      "minimum": 7,
      "maximum": 35,
      "default": 7
    },
    "registry_server": {
      "type": "string",
      "default": "ghcr.io"
    },
    "registry_username": {
      "type": "string",
      "description": "GitHub account name for GHCR. Empty means a public image with no pull credential."
    },
    "vnet_address_space": {
      "type": "string",
      "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/(1[0-9]|2[0-2])$",
      "default": "10.60.0.0/16"
    },
    "tags": {
      "type": "object",
      "required": ["owner", "costCenter"],
      "additionalProperties": { "type": "string" },
      "properties": {
        "owner": { "type": "string", "minLength": 1 },
        "costCenter": { "type": "string", "minLength": 1 }
      },
      "description": "owner and costCenter are mandatory and must never be guessed. Ask the requester."
    }
  },
  "allOf": [
    {
      "$comment": "memory must be exactly 2x cpu",
      "anyOf": [
        { "properties": { "cpu": { "const": 0.25 }, "memory": { "const": "0.5Gi" } }, "required": ["cpu", "memory"] },
        { "properties": { "cpu": { "const": 0.5 }, "memory": { "const": "1Gi" } }, "required": ["cpu", "memory"] },
        { "properties": { "cpu": { "const": 0.75 }, "memory": { "const": "1.5Gi" } }, "required": ["cpu", "memory"] },
        { "properties": { "cpu": { "const": 1.0 }, "memory": { "const": "2Gi" } }, "required": ["cpu", "memory"] },
        { "properties": { "cpu": { "const": 1.25 }, "memory": { "const": "2.5Gi" } }, "required": ["cpu", "memory"] },
        { "properties": { "cpu": { "const": 1.5 }, "memory": { "const": "3Gi" } }, "required": ["cpu", "memory"] },
        { "properties": { "cpu": { "const": 1.75 }, "memory": { "const": "3.5Gi" } }, "required": ["cpu", "memory"] },
        { "properties": { "cpu": { "const": 2.0 }, "memory": { "const": "4Gi" } }, "required": ["cpu", "memory"] },
        { "not": { "anyOf": [{ "required": ["cpu"] }, { "required": ["memory"] }] } }
      ]
    }
  ]
}
